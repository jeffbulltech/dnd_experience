# ── Required ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dnd_ai

# ── Ollama (LLM) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=16384    # context window in tokens (Ollama default is only 2048 — keep this set!)
OLLAMA_TEMPERATURE=0.8  # 0.8 = creative but coherent; lower for stricter rule adherence

# ── App settings ──────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_AUTH=5/minute
